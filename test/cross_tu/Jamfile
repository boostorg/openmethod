# A member method declared in a header and used from two translation units.
# Every other test here is a single TU, so nothing else can catch a _MEM macro
# whose generated member names differ between TUs.
#
# The project requirements of test/Jamfile - including
# <library>/boost/openmethod//boost_openmethod - propagate to this Jamfile.

import testing ;

run main.cpp other_tu.cpp
    /boost/test//boost_unit_test_framework/<warnings>off/<link>static
    :
    :
    :
    : test_cross_tu
    ;
